# ─── Stage 1: Build ───────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Accept build-time VITE env vars
ARG VITE_API_URL=/api
ARG VITE_WS_URL=/ws
ARG VITE_GEOSERVER_URL=/geoserver

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_WS_URL=$VITE_WS_URL
ENV VITE_GEOSERVER_URL=$VITE_GEOSERVER_URL

# Install dependencies first (cache-friendly)
COPY package.json package-lock.json* ./
RUN npm install --prefer-offline --no-audit --no-fund

# Copy source and build
COPY . .
RUN npm run build

# ─── Stage 2: Output ──────────────────────────────────────────
# Tiny image — just contains the built dist/
FROM alpine:3.19 AS runner

WORKDIR /app

COPY --from=builder /app/dist ./dist

# Default: copy to /dist volume mount
CMD ["sh", "-c", "cp -r /app/dist/. /dist/ && echo '✔ Frontend built and copied.' && ls /dist"]
