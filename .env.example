# =============================================================
# MineGIS-TS Environment Variables
# Government of Telangana — Department of Mines & Geology
# =============================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env

# -------------------------------------------------------------
# Django
# -------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-use-python-secrets-token-hex-50
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# -------------------------------------------------------------
# Database (PostGIS)
# -------------------------------------------------------------
DB_NAME=minegis_ts
DB_USER=minegis_user
DB_PASSWORD=MineGIS_DB_2026!
DB_HOST=db
DB_PORT=5432

# -------------------------------------------------------------
# Redis (Django Channels + Celery)
# -------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -------------------------------------------------------------
# GeoServer
# -------------------------------------------------------------
GEOSERVER_URL=http://geoserver:8080/geoserver
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=MineGIS_GS_2026!
GEOSERVER_WORKSPACE=minegis_ts

# -------------------------------------------------------------
# Netradyne Vehicle Tracking API
# Set NETRADYNE_MOCK_MODE=true to use simulated vehicle data
# without real API credentials (recommended for dev/demo)
# -------------------------------------------------------------
NETRADYNE_API_URL=https://api.netradyne.com
NETRADYNE_API_KEY=your-netradyne-api-key-here
NETRADYNE_WEBHOOK_SECRET=your-webhook-secret-here
NETRADYNE_MOCK_MODE=true

# -------------------------------------------------------------
# Frontend (Vite build-time env vars — prefix VITE_)
# -------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws
VITE_GEOSERVER_URL=http://localhost:8080/geoserver

# -------------------------------------------------------------
# JWT Token Lifetimes
# -------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# -------------------------------------------------------------
# Email (for alert notifications)
# -------------------------------------------------------------
EMAIL_HOST=smtp.gov.in
EMAIL_PORT=587
EMAIL_HOST_USER=minegis@mines.telangana.gov.in
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=MineGIS-TS <minegis@mines.telangana.gov.in>

# -------------------------------------------------------------
# Celery Beat (vehicle sync interval)
# -------------------------------------------------------------
VEHICLE_SYNC_INTERVAL_SECONDS=30
